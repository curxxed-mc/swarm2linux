// Swarm's device cards: status, power options, charging hub and notifications, plus an About card.

import { AboutSlint, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Headset, Prefs, About, ThemeChoice, Diagnostics, DiagnosticRow } from "../state.slint";
import { Card, Label, Hint, Toggle, GradientSlider, Dropdown, InfoRow, OutlineButton, SavedItem } from "../widgets/controls.slint";

// A setting name with its control on the right.
component Setting inherits HorizontalLayout {
    in property <string> label;
    spacing: 16px;
    min-height: 34px;
    Label { text: root.label.to-uppercase(); }
    @children
}

component StatusCard inherits Card {
    title: "Device status";

    VerticalLayout {
        spacing: 10px;
        HorizontalLayout {
            Text {
                text: "BATTERY";
                color: Theme.muted;
                font-size: Theme.small-size;
                letter-spacing: 0.5px;
                vertical-alignment: center;
            }
            Text {
                text: Headset.battery < 0 ? "unknown" : Headset.battery + "%" + (Headset.charging ? ", charging" : "");
                color: Theme.text;
                font-size: Theme.label-size;
                horizontal-alignment: right;
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Theme.track;
            Rectangle {
                x: 0;
                width: Headset.battery < 0 ? 0 : parent.width * Headset.battery / 100;
                border-radius: 2px;
                background: Headset.battery >= 0 && Headset.battery <= 15 && !Headset.charging ? Theme.bad : Theme.good;
            }
        }
    }

    VerticalLayout {
        InfoRow {
            label: "Transmitter";
            value: Headset.connected ? Headset.device : "not found";
        }
        InfoRow {
            label: "Headset";
            value: !Headset.connected ? "–" : (Headset.headset-link ? "connected" : "off or out of range");
        }
        InfoRow {
            label: "Name";
            value: Headset.name;
        }
        InfoRow {
            label: "Firmware";
            value: Headset.firmware;
        }
    }

    if Headset.transmitters.length > 0: VerticalLayout {
        spacing: 4px;
        Text {
            text: "CROSSPLAY";
            color: Theme.muted;
            font-size: Theme.small-size;
            letter-spacing: 1px;
        }
        for line in Headset.transmitters: Text {
            text: line;
            color: Theme.text;
            font-size: Theme.label-size;
        }
    }
}

component PowerCard inherits Card {
    title: "Power options";

    Setting {
        label: "Auto shut-off";
        Dropdown {
            name: "Auto shut-off";
            choices: Headset.auto-shutoff-options;
            current: Headset.auto-shutoff;
            enabled: Headset.available;
            selected(v) => {
                Headset.auto-shutoff = v;
                Headset.set-int("auto_shutoff", v);
            }
        }
    }
    Setting {
        label: "Wake on motion";
        Toggle {
            name: "Wake on motion";
            y: (parent.height - self.height) / 2;
            checked: Headset.wake-on-motion;
            enabled: Headset.available;
            toggled(on) => {
                Headset.wake-on-motion = on;
                Headset.set-bool("wake_on_motion", on);
            }
        }
    }
}

// Saved sets of settings: choose one to apply it, or save the current settings as a new one. The chosen profile
// stays selected; changes made afterwards mark it modified, with Save and Revert.
component ProfilesCard inherits Card {
    private property <bool> naming;
    private property <string> new-name;
    private property <string> name-problem: Headset.profile-name-problem(root.new-name);
    private property <bool> replaces: Headset.profile-exists(root.new-name);

    function save() {
        if (root.new-name != "" && root.name-problem == "") {
            Headset.save-profile(root.new-name);
            root.naming = false;
            root.new-name = "";
        }
    }

    title: "Profiles";

    VerticalLayout {
        spacing: 2px;
        for name in Headset.profiles: SavedItem {
            name: name;
            current: name == Headset.active-profile;
            enabled: Headset.available;
            selected => {
                Headset.apply-profile(name);
            }
            deleted => {
                Headset.delete-profile(name);
            }
        }
        if Headset.profiles.length == 0: Hint {
            text: "None yet. Set the headset up for an activity, then save it as a profile.";
        }
    }

    if Headset.active-profile != "" && Headset.profile-modified: HorizontalLayout {
        spacing: 12px;
        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: Theme.warn;
        }
        Text {
            text: "Changed since " + Headset.active-profile + " was applied";
            color: Theme.text;
            font-size: Theme.label-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        OutlineButton {
            text: "Revert";
            enabled: Headset.available;
            clicked => {
                Headset.apply-profile(Headset.active-profile);
            }
        }
        OutlineButton {
            text: "Save";
            primary: true;
            enabled: Headset.available;
            clicked => {
                Headset.save-profile(Headset.active-profile);
            }
        }
    }

    if !root.naming: HorizontalLayout {
        alignment: end;
        OutlineButton {
            text: "Save current settings";
            enabled: Headset.available;
            clicked => {
                root.naming = true;
            }
        }
    }

    if root.naming: VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "Profile name";
                text <=> root.new-name;
                accepted => {
                    root.save();
                }
                init => {
                    self.focus();
                }
            }
            OutlineButton {
                text: "Cancel";
                clicked => {
                    root.naming = false;
                    root.new-name = "";
                }
            }
            OutlineButton {
                text: root.replaces ? "Replace" : "Save";
                primary: true;
                enabled: Headset.available && root.new-name != "" && root.name-problem == "";
                clicked => {
                    root.save();
                }
            }
        }
        if root.name-problem != "": Text {
            text: root.name-problem;
            color: Theme.bad;
            font-size: Theme.small-size;
        }
        if root.name-problem == "" && root.replaces: Hint {
            text: "Replaces the saved profile with this name.";
        }
    }

    Hint {
        text: "A profile holds noise cancellation, Superhuman Hearing, the microphone settings, both equalizers (their presets and bands), and the button and wheel functions. Changes you make after choosing one show here until you save or revert them.";
    }
}

component HubCard inherits Card {
    title: "Charging hub";

    Setting {
        label: "Status";
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 8px;
                height: 8px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: Headset.hub-status == "Active" ? Theme.good : (Headset.hub-status == "Standby" ? Theme.warn : Theme.dim);
            }
            Text {
                text: Headset.hub-status;
                color: Theme.text;
                font-size: Theme.label-size;
                vertical-alignment: center;
            }
        }
    }
    VerticalLayout {
        spacing: 12px;
        Label { text: "LED 1"; }
        GradientSlider {
            name: "Charging hub LED 1";
            value: Headset.hub-led-1;
            enabled: Headset.available;
            released(v) => {
                Headset.hub-led-1 = v;
                Headset.set-int("hub_led_1", v);
            }
        }
    }
    VerticalLayout {
        spacing: 12px;
        Label { text: "LED 2"; }
        GradientSlider {
            name: "Charging hub LED 2";
            value: Headset.hub-led-2;
            enabled: Headset.available;
            released(v) => {
                Headset.hub-led-2 = v;
                Headset.set-int("hub_led_2", v);
            }
        }
    }
}

component NotificationsCard inherits Card {
    title: "Notifications and startup";

    VerticalLayout {
        spacing: 8px;
        Setting {
            label: "Battery pop-ups";
            Toggle {
                name: "Battery pop-ups";
                y: (parent.height - self.height) / 2;
                checked: Headset.battery-notifications;
                enabled: Headset.daemon-running;
                toggled(on) => {
                    Headset.battery-notifications = on;
                    Headset.set-battery-notifications(on);
                }
            }
        }
        Hint { text: "stealthd warns at 15% and 5% while the headset is not charging."; }
    }
    VerticalLayout {
        spacing: 8px;
        Setting {
            label: "Battery in the tray";
            Toggle {
                name: "Battery in the tray";
                y: (parent.height - self.height) / 2;
                checked: Prefs.tray;
                toggled(on) => {
                    Prefs.tray = on;
                    Prefs.changed();
                }
            }
        }
        Hint { text: "Shows the battery level in the system tray. Closing the window keeps the app there."; }
    }
    VerticalLayout {
        spacing: 8px;
        Setting {
            label: "Start with the session";
            Toggle {
                name: "Start with the session";
                y: (parent.height - self.height) / 2;
                checked: Prefs.autostart;
                toggled(on) => {
                    Prefs.autostart = on;
                    Prefs.changed();
                }
            }
        }
        Hint { text: Prefs.tray ? "Starts in the tray when you log in." : "Opens the window when you log in."; }
    }
}

// Experimental voice commands: stealthd runs stealth-voice while this is on.
component VoiceCard inherits Card {
    title: "Voice commands (experimental)";

    VerticalLayout {
        spacing: 8px;
        Setting {
            label: "Listen for \"Stealth, …\"";
            Toggle {
                name: "Voice commands";
                y: (parent.height - self.height) / 2;
                checked: Headset.voice-commands;
                enabled: Headset.daemon-running;
                toggled(on) => {
                    Headset.voice-commands = on;
                    Headset.set-bool("voice_commands", on);
                }
            }
        }
        Setting {
            label: "Microphone";
            Dropdown {
                name: "Voice commands microphone";
                y: (parent.height - self.height) / 2;
                width: 240px;
                choices: Headset.voice-mic-choices;
                current: Headset.voice-mic-index;
                enabled: Headset.daemon-running;
                selected(i) => {
                    Headset.voice-mic-index = i;
                    Headset.set-voice-microphone(Headset.voice-mic-names[i]);
                }
            }
        }
        if Headset.voice-commands && Headset.voice-status != "": Text {
            text: "Status: " + Headset.voice-status;
            color: Headset.voice-status == "listening" ? Theme.good : Theme.muted;
            font-size: Theme.small-size;
            wrap: word-wrap;
        }
        Hint {
            text: "Say \"Stealth, skip this song\", \"pause\", \"resume\", \"go back\", \"volume up\" or \"noise cancelling off\". Speech is recognised on this computer. The first start downloads a 57 MB speech model.";
        }
    }
}

// The self-diagnostic: what the app needs, checked, with how to fix what is wrong.
component DiagnosticsCard inherits Card {
    private property <bool> copied;

    title: "Diagnostics";

    Hint {
        text: Diagnostics.rows.length == 0
            ? "Checks the device, permissions, stealthd, the headset, the volume and the app's files, and says how to fix what is wrong."
            : Diagnostics.summary;
    }
    HorizontalLayout {
        spacing: 12px;
        alignment: end;
        if Diagnostics.rows.length > 0: OutlineButton {
            text: root.copied ? "Copied" : "Copy report";
            clicked => {
                copier.select-all();
                copier.copy();
                copier.clear-selection();
                root.copied = true;
            }
        }
        OutlineButton {
            text: Diagnostics.running ? "Checking…" : (Diagnostics.rows.length == 0 ? "Run checks" : "Check again");
            primary: Diagnostics.rows.length == 0;
            enabled: !Diagnostics.running;
            clicked => {
                root.copied = false;
                Diagnostics.run();
            }
        }
    }

    if Diagnostics.rows.length > 0: VerticalLayout {
        spacing: 6px;
        for row in Diagnostics.rows: VerticalLayout {
            spacing: 4px;
            if row.first: Text {
                text: row.group.to-uppercase();
                color: Theme.muted;
                font-size: Theme.small-size;
                letter-spacing: 1px;
            }
            // the text in a column of its own, with the dot beside its first line: wrapped text keeps its height
            Rectangle {
                VerticalLayout {
                    padding-left: 18px;
                    spacing: 2px;
                    Text {
                        text: row.title;
                        color: row.level == 0 ? Theme.muted : Theme.text;
                        font-size: Theme.label-size;
                        wrap: word-wrap;
                    }
                    if row.hint != "": Text {
                        text: row.hint;
                        color: Theme.muted;
                        font-size: Theme.small-size;
                        wrap: word-wrap;
                    }
                }
                Rectangle {
                    x: 0;
                    y: 6px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: row.level == 3 ? Theme.bad : (row.level == 2 ? Theme.warn : (row.level == 1 ? Theme.good : Theme.dim));
                }
            }
        }
    }

    // holds the report for Copy report; never shown
    copier := TextInput {
        text: Diagnostics.report;
        read-only: true;
        width: 0;
        height: 0;
        opacity: 0;
    }
}

// One theme of the picker, in its own colours.
component ThemeCard {
    in property <ThemeChoice> choice;
    in property <bool> current;
    callback picked();

    height: 86px;
    accessible-role: button;
    accessible-label: root.choice.name;
    accessible-checked: root.current;
    accessible-action-default => { root.picked(); }

    Rectangle {
        border-radius: 8px;
        background: root.choice.background;
        border-width: root.current ? 2px : 1px;
        border-color: root.current ? Theme.accent : (touch.has-hover ? Theme.outline : Theme.line);
        clip: true;

        Rectangle {
            x: 10px;
            y: 10px;
            width: parent.width - 20px;
            height: parent.height - 20px;
            border-radius: 5px;
            background: root.choice.card;
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                Text {
                    text: root.choice.name;
                    color: root.choice.text;
                    font-size: Theme.small-size;
                    font-weight: 600;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.choice.label;
                        color: root.choice.muted;
                        font-size: 11px;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    for swatch in [root.choice.accent, root.choice.fill-end, root.choice.good]: Rectangle {
                        width: 10px;
                        height: 10px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 5px;
                        background: swatch;
                    }
                }
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// The colour theme: a card per theme, as many to a row as fit.
component AppearanceCard inherits Card {
    title: "Appearance";

    grid := Rectangle {
        property <length> gap: 10px;
        property <int> columns: max(1, floor((self.width + self.gap) / (150px + self.gap)));
        property <length> cell: (self.width - (self.columns - 1) * self.gap) / self.columns;
        height: ceil(Prefs.themes.length / self.columns) * (86px + self.gap) - self.gap;
        for choice[i] in Prefs.themes: ThemeCard {
            x: mod(i, grid.columns) * (grid.cell + grid.gap);
            y: floor(i / grid.columns) * (86px + grid.gap);
            width: grid.cell;
            choice: choice;
            current: choice.name == Prefs.theme;
            picked => {
                Prefs.theme = choice.name;
                Prefs.changed();
            }
        }
    }
    Hint {
        text: "Swarm is the app's own look; the others are the palettes of the iced toolkit. Follow system uses Swarm while the desktop is dark and Light while it is light.";
    }
}

component AboutCard inherits Card {
    title: "About";

    HorizontalLayout {
        spacing: 24px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 10px;
            alignment: start;
            Text {
                text: "swarm2linux " + About.version;
                color: Theme.text;
                font-size: Theme.label-size;
            }
            Hint {
                text: "An unofficial Linux app for the Turtle Beach Stealth Pro II, not affiliated with Turtle Beach.";
            }
            Hint {
                text: "This fork is maintained by curxxed-mc: github.com/curxxed-mc/swarm2linux";
            }
            Hint {
                text: "Based on swarm2linux by tbt9czsdd4-droid: github.com/tbt9czsdd4-droid/swarm2linux";
            }
        }
        // Slint's credit, which its royalty-free licence asks for in the About screen
        VerticalLayout {
            alignment: start;
            AboutSlint {
                width: 150px;
            }
        }
    }
}

export component DevicePage inherits VerticalLayout {
    spacing: 24px;

    HorizontalLayout {
        spacing: 24px;
        alignment: stretch;

        VerticalLayout {
            // the columns share the width equally, whatever their cards hold
            horizontal-stretch: 1;
            preferred-width: 0px;
            spacing: 24px;
            alignment: start;
            StatusCard { }
            ProfilesCard { }
            PowerCard { }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            preferred-width: 0px;
            spacing: 24px;
            alignment: start;
            HubCard { }
            NotificationsCard { }
            VoiceCard { }
            AppearanceCard { }
            AboutCard { }
        }
    }

    // full width: its lines are long
    DiagnosticsCard { }
}
