// Swarm's device cards: status, power options, charging hub and notifications, plus an About card.

import { AboutSlint, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Headset, Prefs, About } from "../state.slint";
import { Card, Label, Hint, Toggle, GradientSlider, Dropdown, InfoRow, OutlineButton, SavedItem } from "../widgets/controls.slint";

// A setting name with its control on the right.
component Setting inherits HorizontalLayout {
    in property <string> label;
    spacing: 16px;
    min-height: 34px;
    Label { text: root.label.to-uppercase(); }
    @children
}

component StatusCard inherits Card {
    title: "Device status";

    VerticalLayout {
        spacing: 10px;
        HorizontalLayout {
            Text {
                text: "BATTERY";
                color: Theme.muted;
                font-size: Theme.small-size;
                letter-spacing: 0.5px;
                vertical-alignment: center;
            }
            Text {
                text: Headset.battery < 0 ? "unknown" : Headset.battery + "%" + (Headset.charging ? ", charging" : "");
                color: Theme.text;
                font-size: Theme.label-size;
                horizontal-alignment: right;
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Theme.track;
            Rectangle {
                x: 0;
                width: Headset.battery < 0 ? 0 : parent.width * Headset.battery / 100;
                border-radius: 2px;
                background: Headset.battery >= 0 && Headset.battery <= 15 && !Headset.charging ? Theme.bad : Theme.good;
            }
        }
    }

    VerticalLayout {
        InfoRow {
            label: "Transmitter";
            value: Headset.connected ? Headset.device : "not found";
        }
        InfoRow {
            label: "Headset";
            value: !Headset.connected ? "–" : (Headset.headset-link ? "connected" : "off or out of range");
        }
        InfoRow {
            label: "Name";
            value: Headset.name;
        }
        InfoRow {
            label: "Firmware";
            value: Headset.firmware;
        }
    }

    if Headset.transmitters.length > 0: VerticalLayout {
        spacing: 4px;
        Text {
            text: "CROSSPLAY";
            color: Theme.muted;
            font-size: Theme.small-size;
            letter-spacing: 1px;
        }
        for line in Headset.transmitters: Text {
            text: line;
            color: Theme.text;
            font-size: Theme.label-size;
        }
    }
}

component PowerCard inherits Card {
    title: "Power options";

    Setting {
        label: "Auto shut-off";
        Dropdown {
            name: "Auto shut-off";
            choices: Headset.auto-shutoff-options;
            current: Headset.auto-shutoff;
            enabled: Headset.available;
            selected(v) => {
                Headset.auto-shutoff = v;
                Headset.set-int("auto_shutoff", v);
            }
        }
    }
    Setting {
        label: "Wake on motion";
        Toggle {
            name: "Wake on motion";
            y: (parent.height - self.height) / 2;
            checked: Headset.wake-on-motion;
            enabled: Headset.available;
            toggled(on) => {
                Headset.wake-on-motion = on;
                Headset.set-bool("wake_on_motion", on);
            }
        }
    }
}

// Saved sets of settings: choose one to apply it, or save the current settings as a new one. The chosen profile
// stays selected; changes made afterwards mark it modified, with Save and Revert.
component ProfilesCard inherits Card {
    private property <bool> naming;
    private property <string> new-name;
    private property <string> name-problem: Headset.profile-name-problem(root.new-name);
    private property <bool> replaces: Headset.profile-exists(root.new-name);

    function save() {
        if (root.new-name != "" && root.name-problem == "") {
            Headset.save-profile(root.new-name);
            root.naming = false;
            root.new-name = "";
        }
    }

    title: "Profiles";

    VerticalLayout {
        spacing: 2px;
        for name in Headset.profiles: SavedItem {
            name: name;
            current: name == Headset.active-profile;
            enabled: Headset.available;
            selected => {
                Headset.apply-profile(name);
            }
            deleted => {
                Headset.delete-profile(name);
            }
        }
        if Headset.profiles.length == 0: Hint {
            text: "None yet. Set the headset up for an activity, then save it as a profile.";
        }
    }

    if Headset.active-profile != "" && Headset.profile-modified: HorizontalLayout {
        spacing: 12px;
        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: Theme.warn;
        }
        Text {
            text: "Changed since " + Headset.active-profile + " was applied";
            color: Theme.text;
            font-size: Theme.label-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        OutlineButton {
            text: "Revert";
            enabled: Headset.available;
            clicked => {
                Headset.apply-profile(Headset.active-profile);
            }
        }
        OutlineButton {
            text: "Save";
            primary: true;
            enabled: Headset.available;
            clicked => {
                Headset.save-profile(Headset.active-profile);
            }
        }
    }

    if !root.naming: HorizontalLayout {
        alignment: end;
        OutlineButton {
            text: "Save current settings";
            enabled: Headset.available;
            clicked => {
                root.naming = true;
            }
        }
    }

    if root.naming: VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "Profile name";
                text <=> root.new-name;
                accepted => {
                    root.save();
                }
                init => {
                    self.focus();
                }
            }
            OutlineButton {
                text: "Cancel";
                clicked => {
                    root.naming = false;
                    root.new-name = "";
                }
            }
            OutlineButton {
                text: root.replaces ? "Replace" : "Save";
                primary: true;
                enabled: Headset.available && root.new-name != "" && root.name-problem == "";
                clicked => {
                    root.save();
                }
            }
        }
        if root.name-problem != "": Text {
            text: root.name-problem;
            color: Theme.bad;
            font-size: Theme.small-size;
        }
        if root.name-problem == "" && root.replaces: Hint {
            text: "Replaces the saved profile with this name.";
        }
    }

    Hint {
        text: "A profile holds noise cancellation, Superhuman Hearing, the microphone settings, both equalizers (their presets and bands), and the button and wheel functions. Changes you make after choosing one show here until you save or revert them.";
    }
}

component HubCard inherits Card {
    title: "Charging hub";

    Setting {
        label: "Status";
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 8px;
                height: 8px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: Headset.hub-status == "Active" ? Theme.good : (Headset.hub-status == "Standby" ? Theme.warn : Theme.dim);
            }
            Text {
                text: Headset.hub-status;
                color: Theme.text;
                font-size: Theme.label-size;
                vertical-alignment: center;
            }
        }
    }
    VerticalLayout {
        spacing: 12px;
        Label { text: "LED 1"; }
        GradientSlider {
            name: "Charging hub LED 1";
            value: Headset.hub-led-1;
            enabled: Headset.available;
            released(v) => {
                Headset.hub-led-1 = v;
                Headset.set-int("hub_led_1", v);
            }
        }
    }
    VerticalLayout {
        spacing: 12px;
        Label { text: "LED 2"; }
        GradientSlider {
            name: "Charging hub LED 2";
            value: Headset.hub-led-2;
            enabled: Headset.available;
            released(v) => {
                Headset.hub-led-2 = v;
                Headset.set-int("hub_led_2", v);
            }
        }
    }
}

component NotificationsCard inherits Card {
    title: "Notifications and startup";

    VerticalLayout {
        spacing: 8px;
        Setting {
            label: "Battery pop-ups";
            Toggle {
                name: "Battery pop-ups";
                y: (parent.height - self.height) / 2;
                checked: Headset.battery-notifications;
                enabled: Headset.daemon-running;
                toggled(on) => {
                    Headset.battery-notifications = on;
                    Headset.set-battery-notifications(on);
                }
            }
        }
        Hint { text: "stealthd warns at 15% and 5% while the headset is not charging."; }
    }
    VerticalLayout {
        spacing: 8px;
        Setting {
            label: "Battery in the tray";
            Toggle {
                name: "Battery in the tray";
                y: (parent.height - self.height) / 2;
                checked: Prefs.tray;
                toggled(on) => {
                    Prefs.tray = on;
                    Prefs.changed();
                }
            }
        }
        Hint { text: "Shows the battery level in the system tray. Closing the window keeps the app there."; }
    }
    VerticalLayout {
        spacing: 8px;
        Setting {
            label: "Start with the session";
            Toggle {
                name: "Start with the session";
                y: (parent.height - self.height) / 2;
                checked: Prefs.autostart;
                toggled(on) => {
                    Prefs.autostart = on;
                    Prefs.changed();
                }
            }
        }
        Hint { text: Prefs.tray ? "Starts in the tray when you log in." : "Opens the window when you log in."; }
    }
}

component AboutCard inherits Card {
    title: "About";

    HorizontalLayout {
        spacing: 24px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 10px;
            alignment: start;
            Text {
                text: "swarm2linux " + About.version;
                color: Theme.text;
                font-size: Theme.label-size;
            }
            Hint {
                text: "An unofficial Linux app for the Turtle Beach Stealth Pro II, not affiliated with Turtle Beach.";
            }
            Hint {
                text: "This fork is maintained by curxxed-mc: github.com/curxxed-mc/swarm2linux";
            }
            Hint {
                text: "Based on swarm2linux by tbt9czsdd4-droid: github.com/tbt9czsdd4-droid/swarm2linux";
            }
        }
        // Slint's credit, which its royalty-free licence asks for in the About screen
        VerticalLayout {
            alignment: start;
            AboutSlint {
                width: 150px;
            }
        }
    }
}

export component DevicePage inherits HorizontalLayout {
    spacing: 24px;
    alignment: stretch;

    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 24px;
        alignment: start;
        StatusCard { }
        ProfilesCard { }
        PowerCard { }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 24px;
        alignment: start;
        HubCard { }
        NotificationsCard { }
        AboutCard { }
    }
}
